{
  "name": "@imc-monorepo/server",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --inspect --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "tsc",
    "start": "dist/server.js",
    "migration:generate": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:generate src/database/migrations/Init -d src/database/data-source.ts",
    "migration:run": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node -r ts-node/register ../../node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "seed": "ts-node src/database/seed/admin.ts"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jimp": "^0.22.7",
    "jsonwebtoken": "^9.0.0",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.27",
    "uuid": "^9.0.0",
    "yup": "^1.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/uuid": "^9.0.1",
    "eslint": "^8.41.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "ts-node-esm": "^0.0.6",
    "typeorm": "^0.3.27",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.0.4"
  }
}
